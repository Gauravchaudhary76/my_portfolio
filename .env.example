# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: The port that the central Express application binds to.
PORT=3000

# MONGO_URI: MongoDB connection string for cluster message logging.
# Fallback local system is used when omitted to guarantee instant operational previews.
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority"

# EMAIL_USER: Sender Gmail address used by Nodemailer stream protocols.
EMAIL_USER="gauravkr11311@gmail.com"

# EMAIL_PASS: Google App Password for smtp secure email transmission.
EMAIL_PASS="kutqagytkgymufxx"

# RECEIVER_EMAIL: Dedicated email mailbox to receive incoming recruiter messages.
RECEIVER_EMAIL="gauravkr11311@gmail.com"

# RESEND_API_KEY: High-performance REST HTTP alternative for Vercel deployment (free)
RESEND_API_KEY=

# BREVO_API_KEY: Extremely reliable HTTP REST alternative that completely bypasses Gmail 535 errors (300 free emails/day)
BREVO_API_KEY=

# Custom SMTP Support (e.g. Brevo SMTP, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# WEB3FORMS_ACCESS_KEY: Instant zero-configuration free email API key from web3forms.com
WEB3FORMS_ACCESS_KEY=
